@model OrganizationPlatform.Models.BusinessRegisterViewModel
@{
    ViewData["Title"] = "İşletme kaydı";
    var provinces = ViewBag.Provinces as List<OrganizationPlatform.Services.LocationItem> ?? new();
    var districts = ViewBag.Districts as List<OrganizationPlatform.Services.LocationItem> ?? new();
}

<section class="form-page">
    <div class="form-shell">
        <aside class="form-aside">
            <div class="eyebrow"><span class="eyebrow-dot"></span> İşletmeler için</div>
            <h1>Güzel günlerin bir parçası ol.</h1>
            <p>İşletmeni Vera'ya ekle, hizmetlerini etkinlik planlayan kişilerle buluştur.</p>
            <div class="form-aside-note">Profilini oluşturmak yalnızca birkaç dakika sürer.</div>
        </aside>
        <div class="form-content">
            <h2>İşletme profilini oluştur</h2>
            <p class="form-intro">İşletme bilgilerinle aramıza katıl.</p>
            <form asp-controller="Account" asp-action="BusinessRegister" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary-errors"></div>
                <div class="field"><label asp-for="Name">İşletme adı</label><input asp-for="Name" class="form-control" autocomplete="organization" placeholder="İşletmenin adı" /><span asp-validation-for="Name"></span></div>
                <div class="form-grid">
                    <div class="field"><label asp-for="Email">E-posta adresi</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="ornek@mail.com" /><span asp-validation-for="Email"></span></div>
                    <div class="field"><label asp-for="PhoneNumber">Telefon numarası</label><input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="05xx xxx xx xx" /><span asp-validation-for="PhoneNumber"></span></div>
                </div>
                <div class="form-grid">
                    <div class="field"><label asp-for="City">İl</label><select asp-for="City" id="City" class="form-select" required><option value="">İl seçin</option>@foreach (var province in provinces) { <option value="@province.Name" data-id="@province.Id">@province.Name</option> }</select><span asp-validation-for="City"></span></div>
                    <div class="field"><label asp-for="District">İlçe</label><select asp-for="District" id="District" class="form-select" required disabled="@(districts.Count == 0)"><option value="">@(districts.Count == 0 ? "Önce il seçin" : "İlçe seçin")</option>@foreach (var district in districts) { <option value="@district.Name" data-id="@district.Id">@district.Name</option> }</select><span asp-validation-for="District"></span></div>
                </div>
                <p id="businessRegisterLocationError" class="field-help text-danger" aria-live="polite"></p>
                <div class="field"><label asp-for="CategoryId">İşletme kategorisi</label><select asp-for="CategoryId" class="form-select" required><option value="">Kategori seçin</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select><span asp-validation-for="CategoryId"></span></div>
                <div class="form-grid">
                    <div class="field"><label asp-for="Password">Parola</label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" placeholder="Parola oluştur" /><span asp-validation-for="Password"></span></div>
                    <div class="field"><label asp-for="PasswordConfirmation">Parola tekrarı</label><input asp-for="PasswordConfirmation" type="password" class="form-control" autocomplete="new-password" placeholder="Parolanı tekrar gir" /><span asp-validation-for="PasswordConfirmation"></span></div>
                </div>
                <button type="submit" class="btn btn-primary form-submit">İşletme hesabı oluştur <span aria-hidden="true">↗</span></button>
            </form>
            <p class="form-bottom">Zaten hesabın var mı? <a asp-controller="Account" asp-action="Login" asp-route-audience="business">Giriş yap</a></p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const registerCity = document.getElementById('City');
        const registerDistrict = document.getElementById('District');
        const registerLocationError = document.getElementById('businessRegisterLocationError');

        registerCity?.addEventListener('change', async () => {
            registerDistrict.innerHTML = '<option value="">İlçe seçin</option>';
            registerDistrict.disabled = true;
            registerLocationError.textContent = '';
            const provinceId = registerCity.options[registerCity.selectedIndex]?.dataset.id;
            if (!provinceId) return;

            try {
                const response = await fetch(`/Venues/GetDistricts?provinceId=${encodeURIComponent(provinceId)}`);
                if (!response.ok) throw new Error();
                (await response.json()).forEach(district => {
                    const option = new Option(district.name, district.name);
                    option.dataset.id = district.id;
                    registerDistrict.add(option);
                });
                registerDistrict.disabled = false;
            } catch {
                registerLocationError.textContent = 'İlçeler yüklenemedi. Lütfen tekrar deneyin.';
            }
        });
    </script>
}
