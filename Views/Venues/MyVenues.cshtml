@model List<OrganizationPlatform.Models.Venue>

@{
    ViewData["Title"] = "Mekânlarım";
}

<section class="listing-page">
    <div class="listing-heading">
        <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            İşletme yönetimi
        </div>

        <h1>Mekânlarım</h1>
        <p>İşletmene ait mekânları buradan görüntüleyebilirsin.</p>
        <a asp-controller="Venues" asp-action="Create" class="btn btn-primary">
            + Yeni Mekân Ekle
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2 class="h5 text-dark">Henüz mekân eklemedin</h2>
            <p class="mb-0">İlk mekânını eklediğinde burada görüntülenecek.</p>
        </div>
    }
    else
    {
        <div class="table-shell">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Mekân</th>
                            <th>Şehir</th>
                            <th>Kapasite</th>
                            <th>Adres</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>


                    <tbody>
                        @foreach (var venue in Model)
                        {
                            <tr>
                                <td><strong>@venue.Name</strong></td>
                                <td>@venue.City</td>
                                <td>@venue.Capacity kişi</td>
                                <td>@venue.Address</td>
                                <td>
                                    <a asp-controller="Venues" asp-action="Edit" asp-route-id="@venue.Id"
                                       class="btn btn-warning btn-sm">
                                        Düzenle
                                    </a>

                                    <form asp-controller="Venues" asp-action="Delete" asp-route-id="@venue.Id" method="post"
                                          onsubmit="return confirm('Bu mekânı silmek istediğine emin misin?');" class="d-inline">

                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Sil
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>