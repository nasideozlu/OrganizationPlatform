
@model List<OrganizationPlatform.Models.Venue>

@{
    ViewData["Title"] = "Mekânlar";
}

<h1>Mekânlar</h1>

@if (Model.Count == 0)
{
    <p>Henüz kayıtlı mekân bulunmuyor.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Şehir</th>
                <th>Kapasite</th>
                <th>Adres</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venue in Model)
            {
                <tr>
                    <td>@venue.Name</td>
                    <td>@venue.City</td>
                    <td>@venue.Capacity</td>
                    <td>@venue.Address</td>
                </tr>
            }
        </tbody>
    </table>
}
