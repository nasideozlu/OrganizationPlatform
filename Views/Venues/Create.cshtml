@model OrganizationPlatform.Models.CreateVenueViewModel

@{
    ViewData["Title"] = "Yeni mekân ekle";
    var features = ViewBag.PhysicalFeatures
        as List<OrganizationPlatform.Models.PhysicalFeature>
        ?? new List<OrganizationPlatform.Models.PhysicalFeature>();
}

<section class="form-page">
    <div class="form-shell">
        <div class="form-content">
            <h1>Yeni mekân ekle</h1>
            <p class="form-intro">
                Mekân bilgilerini ve fiziksel özelliklerini doldur.
            </p>

            <form asp-controller="Venues" asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="field">
                    <label asp-for="Name">Mekân adı</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="City">Şehir</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Capacity">Kapasite (kişi)</label>
                    <input asp-for="Capacity" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Address">Açık adres</label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Description">Açıklama (isteğe bağlı)</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MealIncludedPrice" class="form-label">
                        Yemekli Kişi Başı Fiyat (TL)
                    </label>
                    <input asp-for="MealIncludedPrice" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="MealIncludedPrice" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MealExcludedPrice" class="form-label">
                        Yemeksiz Kişi Başı Fiyat (TL)
                    </label>
                    <input asp-for="MealExcludedPrice" class="form-control" type="number" step="0.01" min="0.01" />
                    <span asp-validation-for="MealExcludedPrice" class="text-danger"></span>
                </div>

                <hr />

                <h2 class="h4">Fiziksel özellikler</h2>
                <p class="text-muted">
                    Mekânında bulunan özellikleri seçebilirsin.
                </p>

                @if (features.Count == 0)
                {
                    <p>Henüz tanımlanmış fiziksel özellik bulunmuyor.</p>
                }
                else
                {
                    var categories = features
                        .GroupBy(feature => feature.Category.Name)
                        .OrderBy(group => group.Key);

                    foreach (var category in categories)
                    {
                        <h3 class="h6 mt-3">@category.Key</h3>

                        foreach (var feature in category)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedPhysicalFeatureIds"
                                       value="@feature.Id" id="feature-@feature.Id" />

                                <label class="form-check-label" for="feature-@feature.Id">
                                    @feature.Name
                                </label>
                            </div>
                        }
                    }
                }

                <button type="submit" class="btn btn-primary mt-4">
                    Mekânı kaydet
                </button>

                <a asp-controller="Venues" asp-action="MyVenues" class="btn btn-outline-secondary mt-4">
                    Vazgeç
                </a>
            </form>
        </div>
    </div>
</section>
