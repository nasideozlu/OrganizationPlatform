
@model OrganizationPlatform.Models.FeatureCategory

@{
    ViewData["Title"] = "Özellik Grubunu Düzenle";
}

<div class="container mt-4">
    <h1>Özellik Grubunu Düzenle</h1>

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          class="mt-4">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Grup Adı</label>
            <input asp-for="Name" class="form-control" maxlength="100" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Değişiklikleri Kaydet
        </button>

        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>
