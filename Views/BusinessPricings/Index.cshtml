@model List<OrganizationPlatform.Models.BusinessPricing>
@{
    ViewData["Title"] = "Hizmet Fiyatlarım";
}

<section class="management-page">
    <header class="management-heading">
        <div><div class="eyebrow"><span class="eyebrow-dot"></span> İŞLETMEM · HİZMETLER</div><h1>Hizmet fiyatların</h1><p>Müşterilerinle paylaşacağın fiyatları buradan güncel tut.</p></div>
        <a asp-action="Create" class="btn btn-primary">Fiyat ekle <span aria-hidden="true">＋</span></a>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (Model.Count == 0)
    {
        <div class="management-empty"><h2>Henüz fiyat eklemedin</h2><p>Hizmetlerini ve ücretlerini paylaşarak müşterilere karar vermelerinde yardımcı ol.</p><a asp-action="Create" class="btn btn-primary">İlk fiyatını ekle</a></div>
    }
    else
    {
        <div class="management-card-grid">
            @foreach (var pricing in Model)
            {
                var typeLabel = pricing.PricingType switch
                {
                    OrganizationPlatform.Models.BusinessPricingType.Fixed => "Sabit fiyat",
                    OrganizationPlatform.Models.BusinessPricingType.StartingFrom => "Başlangıç fiyatı",
                    OrganizationPlatform.Models.BusinessPricingType.PerPerson => "Kişi başı",
                    OrganizationPlatform.Models.BusinessPricingType.PerHour => "Saatlik",
                    _ => "Fiyat"
                };
                <article class="management-card">
                    <div class="d-flex justify-content-between align-items-start gap-2"><h2>@pricing.ServiceName</h2><span class="status-pill @(pricing.IsActive ? "" : "is-inactive")">@(pricing.IsActive ? "Yayında" : "Pasif")</span></div>
                    <div class="management-card-price">@pricing.Amount.ToString("N2") TL</div>
                    <span class="catalog-location">@typeLabel</span>
                    @if (!string.IsNullOrWhiteSpace(pricing.Description))
                    {
                        <p class="mt-3 mb-0">@pricing.Description</p>
                    }
                    <div class="management-card-actions">
                        <a asp-action="Edit" asp-route-id="@pricing.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form asp-action="ToggleStatus" asp-route-id="@pricing.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(pricing.IsActive ? "Yayından kaldır" : "Yeniden yayınla")</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>
