
@model List<OrganizationPlatform.Models.BusinessCategory>

@{
    ViewData["Title"] = "Yönetici Paneli";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Yönetici Paneli</h1>

        <a asp-controller="Admin"
           asp-action="CreateCategory"
           class="btn btn-success">
            Yeni Kategori Ekle
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">İşletme Kategorileri</h5>
            <p>Toplam kategori: @Model.Count</p>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kategori Adı</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.Id</td>
                                <td>@category.Name</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Admin"
                                           asp-action="EditCategory"
                                           asp-route-id="@category.Id"
                                           class="btn btn-sm btn-primary">
                                            Düzenle
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="DeleteCategory"
                                              asp-route-id="@category.Id"
                                              method="post"
                                              onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Mekân Özellik Grupları</h5>
        <p class="card-text">
            Manzara, Olanaklar ve diğer özellik gruplarını yönetin.
        </p>
        <a asp-controller="FeatureCategories"
           asp-action="Index"
           class="btn btn-primary">
            Özellik Gruplarını Yönet
        </a>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Mekân Özellikleri</h5>

        <p class="card-text">
            Otopark, bahçe, manzara ve diğer mekân özelliklerini yönetin.
        </p>

        <a asp-controller="PhysicalFeatures"
           asp-action="Index"
           class="btn btn-primary">
            Mekân Özelliklerini Yönet
        </a>
    </div>
</div>

