@model OrganizationPlatform.Models.BusinessProfile
@using OrganizationPlatform.Models
@using OrganizationPlatform.ViewModels

@{
    ViewData["Title"] = Model.Name;
    var cover = Model.Photos.OrderByDescending(photo => photo.UploadedAt).FirstOrDefault();

    var ratings = ViewBag.Ratings as List<BusinessRatingViewModel>
    ?? new List<BusinessRatingViewModel>();
}

<section class="public-business-page">
    <a asp-controller="Home" asp-action="Index" asp-fragment="kesfet" class="business-back-link">← Keşfe dön</a>

    <header class="public-business-hero">
        @if (cover != null)
        {
            <img class="public-business-cover" src="@cover.FilePath" alt="@Model.Name işletme fotoğrafı" />
        }
        else
        {
            <div class="public-business-cover public-business-cover-empty" aria-hidden="true">✳</div>
        }
        <div class="public-business-shade"></div>
        <div class="public-business-title">
            <span class="public-business-category">@Model.Category.Name</span>

            <div class="d-flex justify-content-between align-items-center gap-3">
                <h1>@Model.Name</h1>
                @if (ViewBag.RatingCount > 0)
                {
                    <div class="business-rating-summary">

                        <span class="business-rating-star">
                            ★
                        </span>

                        <strong>
                            @(((double)ViewBag.AverageRating).ToString("0.0"))
                        </strong>

                        <span class="text-muted">
                            (@ViewBag.RatingCount değerlendirme)
                        </span>

                    </div>
                }
                else
                {
                    <div class="business-rating-summary">

                        <span class="text-muted">
                            Henüz değerlendirme yapılmadı.
                        </span>

                    </div>
                }

                @if (ViewBag.CanFavorite == true)
                {
                    <form asp-controller="BusinessFavorites" asp-action="ToggleFavorite" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="businessProfileId" value="@Model.Id" />

                        <button type="submit" class="btn btn-light rounded-circle"
                                title="@(ViewBag.IsFavorite == true ? "Favorilerden çıkar" : "Favorilere ekle")">

                            @if (ViewBag.IsFavorite == true)
                            {
                                <span class="text-danger fs-4">♥</span>
                            }
                            else
                            {
                                <span class="text-danger fs-4">♡</span>
                            }

                        </button>
                    </form>
                }
            </div>

            <p>
                <span aria-hidden="true">⌖</span>
                @Model.City@(string.IsNullOrWhiteSpace(Model.District) ? "" : $", {Model.District}")
            </p>
        </div>
    </header>

    <div class="public-business-layout">
        <div class="public-business-main">
            <section class="public-business-panel">
                <span class="dashboard-kicker">İŞLETMENİN HİKÂYESİ</span>
                <h2>@Model.Name</h2>
                <p class="public-business-description">@(string.IsNullOrWhiteSpace(Model.Description) ? "Bu işletme henüz bir açıklama eklememiş." : Model.Description)</p>
                <div class="public-business-facts">
                    <div><span
                        class="detail-icon">✳</span><span><small>Kategori</small><strong>@Model.Category.Name</strong></span>
                    </div>
                    <div><span class="detail-icon">⌖</span><span><small>Hizmet
                        bölgesi</small><strong>@Model.City@(string.IsNullOrWhiteSpace(Model.District) ? "" : $",                                {Model.District}")</strong></span></div>
                    </div>
                </section>

                @if (Model.Campaigns.Any())
                {
                    <section class="public-business-panel public-business-campaigns">
                        <div class="detail-panel-heading">
                            <div>
                                <span class="dashboard-kicker">KAMPANYALAR</span>
                                <h2>Aktif fırsatlar</h2>
                            </div>

                            <span class="business-venue-count">
                                @Model.Campaigns.Count
                            </span>
                        </div>

                        <div class="public-business-campaign-grid">

                            @foreach (var campaign in Model.Campaigns)
                            {
                                <article class="public-business-campaign-card">

                                    <div class="campaign-card-top">
                                        <div>
                                            <span class="campaign-badge">
                                                @if (campaign.CampaignType == BusinessCampaignType.General)
                                                {
                                                    <text>İşletme Kampanyası</text>
                                                }
                                                else
                                                {
                                                    <text>Paket Kampanyası</text>
                                                }
                                            </span>

                                            <h3>@campaign.Name</h3>
                                        </div>

                                        <strong class="campaign-discount">
                                            @if (campaign.DiscountType == DiscountType.Percentage)
                                            {
                                                <text>%@campaign.DiscountValue.ToString("N0")</text>
                                            }
                                            else
                                            {
                                                <text>@campaign.DiscountValue.ToString("N2") TL</text>
                                            }
                                        </strong>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(campaign.Description))
                                    {
                                        <p>@campaign.Description</p>
                                    }

                                    @if (campaign.CampaignType == BusinessCampaignType.Package &&
                                         campaign.BusinessPackage != null)
                                    {
                                        <div class="campaign-package-info">
                                            <small>Kampanyalı paket</small>
                                            <strong>@campaign.BusinessPackage.Name</strong>
                                        </div>
                                    }

                                    <div class="campaign-date">
                                        <span>⌛</span>
                                        <span>
                                            @campaign.StartDate.ToString("dd.MM.yyyy")
                                            -
                                            @campaign.EndDate.ToString("dd.MM.yyyy")
                                        </span>
                                    </div>

                                </article>
                            }

                        </div>
                    </section>
                }

                @if (Model.Pricings.Any())
                {
                    <section class="public-business-panel">
                        <div class="detail-panel-heading">
                            <div>
                                <span class="dashboard-kicker">HİZMETLER VE ÜCRETLER</span>
                                <h2>Fiyat listesi</h2>
                            </div>
                            <span class="business-venue-count">
                                @Model.Pricings.Count
                            </span>
                        </div>

                        <div class="public-business-pricing-list">
                            @foreach (var pricing in Model.Pricings.OrderBy(p => p.ServiceName))
                            {
                                <div class="public-business-pricing-item">
                                    <div class="public-pricing-info">
                                        <h3>@pricing.ServiceName</h3>

                                        @if (!string.IsNullOrWhiteSpace(pricing.Description))
                                        {
                                            <p>@pricing.Description</p>
                                        }
                                    </div>

                                    <div class="public-pricing-price">
                                        <strong>@pricing.Amount.ToString("N2") TL</strong>

                                        <small>
                                            @switch (pricing.PricingType)
                                            {
                                                case OrganizationPlatform.Models.BusinessPricingType.Fixed:
                                                    @:Sabit fiyat
                                                    break;

                                                case OrganizationPlatform.Models.BusinessPricingType.StartingFrom:
                                                    @:Başlangıç fiyatı
                                                    break;

                                                case OrganizationPlatform.Models.BusinessPricingType.PerPerson:
                                                    @:Kişi başı
                                                    break;

                                                case OrganizationPlatform.Models.BusinessPricingType.PerHour:
                                                    @:Saatlik
                                                    break;
                                            }
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }


                @if (Model.Packages.Any())
                {
                    <section class="public-business-panel">
                        <div class="detail-panel-heading">
                            <div>
                                <span class="dashboard-kicker">İŞLETME PAKETLERİ</span>
                                <h2>Hizmet Paketleri</h2>
                            </div>

                            <span class="business-venue-count">
                                @Model.Packages.Count
                            </span>
                        </div>

                        <div class="public-business-package-grid">
                            
                            @foreach (var package in Model.Packages.OrderBy(p => p.Amount))
                            {
                                var packageCampaign = Model.Campaigns
                                    .Where(c => c.CampaignType == BusinessCampaignType.Package
                                                && c.BusinessPackageId == package.Id)
                                    .OrderByDescending(c => c.DiscountType == DiscountType.Percentage
                                        ? package.Amount * c.DiscountValue / 100
                                        : c.DiscountValue)
                                    .FirstOrDefault();

                                var displayedPrice = package.Amount;

                                if (packageCampaign != null)
                                {
                                    if (packageCampaign.DiscountType == DiscountType.Percentage)
                                    {
                                        displayedPrice = package.Amount -
                                            (package.Amount * packageCampaign.DiscountValue / 100);
                                    }
                                    else
                                    {
                                        displayedPrice = package.Amount - packageCampaign.DiscountValue;
                                    }

                                    displayedPrice = Math.Max(0, displayedPrice);
                                }

                                <article class="public-business-package-card">
                                    <div class="public-package-header">
                                        <div>
                                            <h3>@package.Name</h3>

                                            @if (packageCampaign != null)
                                            {
                                                <span class="campaign-badge">Kampanyalı fiyat</span>
                                            }
                                        </div>

                                        <strong>
                                            @displayedPrice.ToString("N2") TL
                                        </strong>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(package.Description))
                                    {
                                        <p class="public-package-description">
                                            @package.Description
                                        </p>
                                    }

                                    <div class="public-package-items">
                                        <h4>Paket içeriği</h4>

                                        <ul>
                                            @foreach (var item in package.Items)
                                            {
                                                <li>
                                                    <span aria-hidden="true">✓</span>
                                                    @item.Name
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                    @if (package.Venues.Any())
                                    {
                                        <div class="public-package-venues"><small>Geçerli mekânlar</small><div>@foreach (var venue in package.Venues.OrderBy(venue => venue.Name)) { <span>⌖ @venue.Name</span> }</div></div>
                                    }
                                </article>
                            }

                        </div>
                    </section>
                }



                @if (Model.Photos.Count > 0)
                {
                    <section class="public-business-panel">
                        <div class="detail-panel-heading">
                            <div><span class="dashboard-kicker">İŞLETMEDEN</span>
                                <h2>Fotoğraf galerisi</h2>
                            </div><span class="business-venue-count">@Model.Photos.Count</span>
                        </div>
                        <div class="public-business-gallery">
                            @foreach (var photo in Model.Photos.OrderByDescending(photo => photo.UploadedAt))
                            {
                                <a href="@photo.FilePath" target="_blank" rel="noopener noreferrer"><img src="@photo.FilePath"
                                                                                                             alt="@Model.Name fotoğrafı" loading="lazy" /></a>
                                }
                            </div>
                        </section>
                    }

                    @if (Model.Venues.Count > 0)
                    {
                        <section class="public-business-panel">
                            <div class="detail-panel-heading">
                                <div><span class="dashboard-kicker">MEKÂNLAR</span>
                                    <h2>Bu işletmenin mekânları</h2>
                                </div><span class="business-venue-count">@Model.Venues.Count</span>
                            </div>
                            <div class="public-business-venue-grid">
                                @foreach (var venue in Model.Venues)
                                {
                                    var venuePhoto = venue.Photos.OrderByDescending(photo => photo.UploadedAt).FirstOrDefault();
                                    <a class="public-business-venue" asp-controller="Venues" asp-action="Details"
                                       asp-route-id="@venue.Id">
                                        @if (venuePhoto != null)
                                        {
                                            <img src="@venuePhoto.FilePath" alt="@venue.Name mekân fotoğrafı" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="public-venue-placeholder" aria-hidden="true">⌖</span>
                                        }
                                        <span class="public-venue-info"><strong>@venue.Name</strong><small>@venue.City · @venue.District
                                            · @venue.Capacity kişi</small><b>Mekân detayları <span
                                            aria-hidden="true">↗</span></b></span>
                                        </a>
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    <aside class="public-business-contact">
                        <span class="dashboard-kicker">İLETİŞİM</span>
                        <h2>İşletmeyle iletişime geç</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.ApplicationUser.Email))
                        {
                            <div class="public-contact-row"><span class="contact-icon">✉</span><span><small>E-posta</small><a
                                href="mailto:@Model.ApplicationUser.Email">@Model.ApplicationUser.Email</a></span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.ApplicationUser.PhoneNumber))
                            {
                                <div class="public-contact-row"><span class="contact-icon">⌕</span><span><small>Telefon</small><a
                                    href="tel:@Model.ApplicationUser.PhoneNumber">@Model.ApplicationUser.PhoneNumber</a></span>
                                </div>
                            }
                            <div class="public-contact-note">İşletme hizmetleri ve uygunluk bilgisi için doğrudan iletişime
                                geçebilirsin.</div>
                                @if (ViewBag.CanRate == true)
                                {
                                    <section class="business-rating-section">

                                        @if (ViewBag.HasRated == true)
                                        {
                                            <div class="rating-thanks"><span aria-hidden="true">✓</span><div><strong>Değerlendirmen alındı</strong><small>Bu işletmeye zaten puan verdin. Katkın için teşekkürler.</small></div></div>
                                        }
                                        else
                                        {
                                            <span class="dashboard-kicker">DENEYİMİNİ PAYLAŞ</span>
                                            <h3>Bu işletmeyi değerlendir</h3>
                                            <p>Diğer çiftlere karar verirken yardımcı ol.</p>

                                            <form asp-controller="BusinessRatings" asp-action="Create" method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="businessProfileId" value="@Model.Id" />

                                                <fieldset class="rating-choice">
                                                    <legend class="form-label">Puanın</legend>
                                                    <div class="rating-choice-options">
                                                        @for (var score = 5; score >= 1; score--)
                                                        {
                                                            <label title="@score yıldız"><input type="radio" name="rating" value="@score" required /><span aria-hidden="true">★</span><small>@score</small></label>
                                                        }
                                                    </div>
                                                </fieldset>

                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        Yorumunuz (isteğe bağlı)
                                                    </label>

                                                    <textarea name="comment" class="form-control" rows="3" maxlength="1000" placeholder="Deneyimini paylaşabilirsin."></textarea>
                                                </div>

                                                <button type="submit" class="btn btn-primary">
                                                    Değerlendirmeyi gönder
                                                </button>

                                            </form>
                                        }

                                    </section>
                                }
                                <div class="business-reviews-section mt-4">

                                    <span class="dashboard-kicker">DEĞERLENDİRMELER</span>
                                    <h3>Müşteri yorumları</h3>

                                    <p class="text-muted">
                                        @ratings.Count değerlendirme
                                    </p>

                                    @if (ratings.Count == 0)
                                    {
                                        <p>Henüz değerlendirme yapılmamış.</p>
                                    }
                                    else
                                    {
                                        @foreach (var rating in ratings)
                                        {
                                            <div class="business-review-card mb-3">

                                                <div class="d-flex justify-content-between">
                                                    <strong>@rating.CustomerName</strong>

                                                    <span>
                                                        @rating.Rating / 5
                                                    </span>
                                                </div>

                                                <div class="text-warning">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        @(i <= rating.Rating ? "★" : "☆")
                                                    }
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(rating.Comment))
                                                {
                                                    <p class="mt-2 mb-0">
                                                        @rating.Comment
                                                    </p>
                                                }

                                                <small class="text-muted">
                                                    @rating.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                                </small>

                                            </div>
                                        }
                                    }

                                </div>
                            </aside>
                        </div>
                    </section>
