@model OrganizationPlatform.Models.BusinessProfileEditViewModel
@{ ViewData["Title"] = "İşletme profilini düzenle"; }
<section class="form-page">
    <div class="form-shell">
        <aside class="form-aside"><div class="eyebrow"><span class="eyebrow-dot"></span> İşletme ayarları</div><h1>İşletmeni en iyi şekilde anlat.</h1><p>Güncel ve doğru bilgiler, etkinlik sahiplerinin sana ulaşmasını kolaylaştırır.</p></aside>
        <div class="form-content">
            <h2>İşletme bilgileri</h2><p class="form-intro">Profilinde görünecek detayları güncelle.</p>
            <form method="post" asp-controller="Profile" asp-action="EditBusiness">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary-errors"></div>
                <div class="field"><label asp-for="Name">İşletme adı</label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name"></span></div>
                <div class="field"><label asp-for="Description">İşletme hakkında</label><textarea asp-for="Description" class="form-control" placeholder="İşletmeni kısaca tanıt"></textarea><span asp-validation-for="Description"></span></div>
                <div class="form-grid">
                    <div class="field"><label asp-for="City">Şehir</label><input asp-for="City" class="form-control" required /><span asp-validation-for="City"></span></div>
                    <div class="field"><label asp-for="CategoryId">Kategori</label><select asp-for="CategoryId" class="form-select" required>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select><span asp-validation-for="CategoryId"></span></div>
                </div>
                <button type="submit" class="btn btn-primary form-submit">Değişiklikleri kaydet</button>
                <p class="form-bottom"><a asp-controller="Profile" asp-action="Index">Profilime dön</a></p>
            </form>
        </div>
    </div>
</section>
