@model OrganizationPlatform.Models.BusinessProfileEditViewModel

<h2>İşletme Profilini Düzenle</h2>

<form method="post" asp-controller="Profile" asp-action="EditBusiness">
    @Html.AntiForgeryToken()

    <div>
        <label for="Name">İşletme Adı</label>
        <input type="text" id="Name" name="Name" value="@Model.Name" required />
    </div>

    <div>
        <label for="Description">Açıklama</label>
        <textarea id="Description" name="Description">@Model.Description</textarea>
    </div>

    <div>
        <label for="City">Şehir</label>
        <input type="text" id="City" name="City" value="@Model.City" required />
    </div>

    <div>
        <label for="CategoryId">Kategori</label>
        <select id="CategoryId" name="CategoryId" required>
            @foreach (var category in Model.Categories)
            {
                if (category.Id == Model.CategoryId)
                {
                    <option value="@category.Id" selected>
                        @category.Name
                    </option>
                }
                else
                {
                    <option value="@category.Id">
                        @category.Name
                    </option>
                }
            }
        </select>
    </div>

    <button type="submit">Değişiklikleri Kaydet</button>
</form>
